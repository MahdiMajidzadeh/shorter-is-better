# Environment for the Docker stack (compose.yaml / compose.local.yaml).
#
# In Dokploy: paste this whole file into the application's "Environment
# Settings" tab and fill in the blanks. compose.yaml defines no defaults of its
# own — every value the app runs with comes from that tab — so a variable left
# out here is a variable the container simply does not have.
#
# Locally:    cp .env.docker.example .env.docker and pass --env-file .env.docker
#
# This file is NOT read by the application directly — the container gets its
# configuration from real environment variables, so `.env` inside the image is
# neither needed nor used.

# Image to deploy. The GitHub Action publishes :latest on every v*.*.* tag push,
# plus :sha-<commit> and :<x.y.z> tags you can pin to.
APP_IMAGE=ghcr.io/mahdimajidzadeh/shorter-is-better:latest

APP_NAME=Shorter
APP_ENV=production
APP_DEBUG=false

# Required. Generate once and keep it stable — changing it invalidates every
# session and every encrypted value:
#   docker run --rm ghcr.io/mahdimajidzadeh/shorter-is-better:latest \
#     php artisan key:generate --show
APP_KEY=

# Required. The public URL, including scheme. Short links are built from this.
APP_URL=https://example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Password for the seeded "admin" account. Leave empty to have the seeder
# generate a random one and print it once in the seed output.
ADMIN_PASSWORD=

# --- Database -------------------------------------------------------------
# DB_HOST must match the database service name in compose.yaml. Point it
# elsewhere only if you also remove that service.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=shorter
DB_USERNAME=shorter
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis ----------------------------------------------------------------
# REDIS_HOST must match the redis service name in compose.yaml.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# TLS is terminated by Dokploy's Traefik in front of the container, so the app
# only ever sees http — but the cookie must still be marked secure. Set this to
# false for a plain-http local run.
SESSION_SECURE_COOKIE=true

# Optional error reporting.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# Local only (compose.local.yaml): host port to publish.
APP_PORT=8080
